{
  "name": "@agent-pixels/paperclip-plugin",
  "version": "0.1.0",
  "description": "Security camera style pixel office plugin for Paperclip",
  "type": "module",
  "private": true,
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf dist",
    "demo:build": "node scripts/demo.mjs",
    "demo:serve": "node scripts/demo.mjs --serve",
    "demo:typecheck": "tsc --noEmit -p tsconfig.demo.json",
    "package:release": "node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
